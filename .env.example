NODE_ENV=development

PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/search_api

JWT_SECRET=make-this-a-long-random-secret-with-more-than-32-characters
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX=100

ADMIN_NAME=Search API Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!